{
  "containerDefinitions": [
    {
      "name": "sql-mcp-server-service",
      "image": "773564674923.dkr.ecr.eu-west-1.amazonaws.com/sql-mcp-server:dev_38_6591250",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SQLSERVER_ENCRYPT",
          "value": "false"
        },
        {
          "name": "SQLSERVER_DATABASE",
          "value": "Proxymity"
        },
        {
          "name": "SQLSERVER_HOST",
          "value": "10.195.4.177"
        },
        {
          "name": "SQLSERVER_TRUST_CERT",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "SQLSERVER_PASSWORD",
          "valueFrom": "arn:aws:ssm:eu-west-1:899187575527:parameter/mssql.mcp.password"
        },
        {
          "name": "SQLSERVER_USER",
          "valueFrom": "arn:aws:ssm:eu-west-1:899187575527:parameter/mssql.mcp.user"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mcp-server-service",
          "mode": "non-blocking",
          "awslogs-multiline-pattern": "^([0-9]{2})-([0-9]{2})-([0-9]{4})",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "family": "sql-mcp-server-service",
  "taskRoleArn": "arn:aws:iam::899187575527:role/role-ecs-task",
  "executionRoleArn": "arn:aws:iam::899187575527:role/role-ecs-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048"
}